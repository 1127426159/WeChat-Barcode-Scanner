.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.card {
  background: #1f2937;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero {
  background: linear-gradient(135deg, #1d4ed8, #047857);
}

.eyebrow {
  color: #bfdbfe;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 16rpx;
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 18rpx;
  color: #dbeafe;
  font-size: 27rpx;
  line-height: 1.7;
}

.section-title {
  color: #e5e7eb;
  font-size: 32rpx;
  font-weight: 600;
}

.section-desc {
  margin-top: 16rpx;
  color: #9ca3af;
  font-size: 27rpx;
  line-height: 1.7;
}

.btn {
  margin-top: 24rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.btn::after {
  border: none;
}

.btn.server {
  background: #2563eb;
}

.system-guide {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #111827;
  color: #d1d5db;
  font-size: 25rpx;
  line-height: 1.9;
}

.btn.copy {
  background: #374151;
  color: #bfdbfe;
}

.tip {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 1.6;
}

.step {
  display: flex;
  margin-top: 28rpx;
  align-items: flex-start;
}

.step-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  flex-shrink: 0;
  border-radius: 50%;
  text-align: center;
  background: #059669;
  color: #fff;
  font-size: 24rpx;
}

.step-body {
  margin-left: 20rpx;
}

.step-title {
  color: #e5e7eb;
  font-size: 29rpx;
}

.step-text {
  margin-top: 8rpx;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 1.7;
}

.github {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #111827;
  color: #93c5fd;
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  word-break: break-all;
}

.contact-email {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #111827;
  color: #34d399;
  font-family: Menlo, Consolas, monospace;
  font-size: 26rpx;
  word-break: break-all;
}

.library-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.library-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #111827;
  color: #93c5fd;
  font-size: 23rpx;
  line-height: 1.4;
}

.thanks {
  margin-top: 24rpx;
  color: #5eead4;
  font-size: 27rpx;
  font-weight: 600;
}

.terminal-command {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #020617;
  color: #a7f3d0;
  font-family: Menlo, Consolas, monospace;
  font-size: 23rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.faq-block {
  margin-top: 10rpx;
}

.faq-question {
  margin-top: 22rpx;
  color: #e5e7eb;
  font-size: 29rpx;
  font-weight: 600;
}

.faq-divider {
  height: 1px;
  margin: 36rpx 0 8rpx;
  background: #374151;
}

.faq {
  position: relative;
  margin-top: 18rpx;
  padding-left: 26rpx;
  color: #9ca3af;
  font-size: 26rpx;
  line-height: 1.65;
}

.faq::before {
  content: "•";
  position: absolute;
  left: 0;
  color: #34d399;
}
